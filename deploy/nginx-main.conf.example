# Target path: /etc/nginx/nginx.conf (replaces the whole file)
#
# Clean base config: no app-specific server blocks live here. Vhosts are added via
# /etc/nginx/sites-available/<name> + a symlink in sites-enabled/ (see
# deploy/nginx.conf.example for the swillfam vhost itself).
#
# Back up whatever's currently there first:
#   sudo cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak

user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;

events {
    worker_connections 1024;
}

http {
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';
    access_log  /var/log/nginx/access.log  main;

    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 2048;

    gzip                on;
    gzip_vary           on;
    gzip_proxied        any;
    gzip_comp_level     5;
    gzip_min_length     1024;
    gzip_types          text/plain text/css text/xml text/javascript
                        application/javascript application/json application/xml
                        application/rss+xml image/svg+xml font/woff2;

    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
