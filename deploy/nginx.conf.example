# Target path: /etc/nginx/sites-available/swillfam
# Requires nginx.conf's http{} block to have `include /etc/nginx/sites-enabled/*;`
# (see deploy/nginx-main.conf.example for a clean base nginx.conf that has it).
#
# Enable with:
#   sudo ln -s /etc/nginx/sites-available/swillfam /etc/nginx/sites-enabled/swillfam
#   sudo rm -f /etc/nginx/sites-enabled/default   # stock Ubuntu default vhost also
#                                                  # claims `default_server` on :80 -
#                                                  # only one is allowed per port.
#   sudo nginx -t && sudo systemctl reload nginx
#
# Reverse proxy for the Next.js app (PM2, listening on 127.0.0.1:3000).
#
# ---------------------------------------------------------------------------
# THIS FILE IS THE PRODUCTION SHAPE (swillfam.com).
#
# The pre-production shape (swillscbd.site behind a password, with an
# X-Robots-Tag: noindex header) is in git history at 35b0bf9. A staging box that
# is not meant to be public needs that gate again - robots.txt alone does not
# keep a URL out of Google, see the notes in that version.
#
# FIRST INSTALL ON A NEW SERVER: the two HTTPS blocks reference a certificate
# that does not exist yet, so `nginx -t` fails. Comment those blocks out (the
# default_server and port-80 blocks are enough), reload, then issue it:
#     sudo certbot --nginx -d swillfam.com -d www.swillfam.com
# and put the blocks back.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. Anything that is not a known hostname  ->  nothing.
#
# A request to the bare IP, or to any domain whose DNS points here without a
# vhost of its own, gets the connection closed (`444`): no content, no duplicate
# host, nothing to index. Certbot's HTTP-01 challenge stays reachable so a
# certificate for a NEW domain can still be issued before it has a vhost.
# ===========================================================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 444;
    }
}

# Same for HTTPS: refuse the TLS handshake for an unknown name (bare IP, an old
# domain) instead of answering with swillfam.com's certificate.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}


# ===========================================================================
# 2. http -> https, one hop.
#
# Every host variant lands on https://swillfam.com in a single 301 - including
# http://www, which must NOT go via https://www first. The brief forbids
# redirect chains, and www.swillfam.com carries 90 referring domains.
#
# Do not let Certbot add its own http block for these names: a second server
# with the same server_name is ignored by nginx (it logs "conflicting server
# name") and its `$host` redirect would be the chain this block avoids.
# ===========================================================================
server {
    listen 80;
    listen [::]:80;
    server_name swillfam.com www.swillfam.com;

    # Renewal over plain http - this location must come before the redirect.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://swillfam.com$request_uri;
    }
}


# ===========================================================================
# 3. www over HTTPS -> apex (needs a certificate that covers www).
# ===========================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.swillfam.com;

    ssl_certificate     /etc/letsencrypt/live/swillfam.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/swillfam.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://swillfam.com$request_uri;
}


# ===========================================================================
# 4. The app, over HTTPS.
# ===========================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name swillfam.com;

    ssl_certificate     /etc/letsencrypt/live/swillfam.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/swillfam.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # The only security header nginx owns - the app sets the other four, and
    # only this layer can promise https for the whole host. It is hard to walk
    # back: browsers remember it for a year, subdomains included. Note that a
    # location with its own add_header (below) does not inherit this one; the
    # HTML responses (`location /`) do, which is all a browser needs to record it.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Match next.config.ts serverActions.bodySizeLimit (15mb) with headroom.
    client_max_body_size 20m;

    # Do NOT add X-Content-Type-Options / Referrer-Policy / X-Frame-Options /
    # Permissions-Policy here: since Fase 8 the app sets all four itself in
    # next.config.ts `headers()`, and setting them again sends each twice.

    # Static build assets are content-hashed -> browser caches them via this header
    # (nginx isn't running its own cache zone, so no proxy_cache_valid here - it'd be inert).
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Admin-uploaded media, served straight from disk so it never touches Node.
    # Filenames are uuids, so the bytes at a given path never change.
    #
    # EDIT THIS PATH: it must be the absolute path to the app checkout (the same
    # directory PM2 uses as `cwd`), and both the location and the alias need their
    # trailing slash.
    #
    # /_next/image?url=/uploads/... still proxies to Node - next/image resolves
    # local paths through an internal request that never leaves the process, and
    # src/app/uploads/[...path]/route.ts is what answers it.
    location /uploads/ {
        alias /home/deployer/swillfam/public/uploads/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # No Upgrade/Connection headers here - this app has no WebSocket/SSE endpoint
        # (next start doesn't use one; only dev-mode HMR does). Forcing every proxied
        # request to look like a protocol upgrade is what caused image responses to
        # come back truncated (ERR_CONTENT_LENGTH_MISMATCH on /_next/image, etc).
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Required, not optional: the contact form's rate limiter buckets by this
        # header (3 submissions / 10 min). Without it every visitor shares one
        # bucket and the fourth message of the day is rejected.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Headroom for slower requests. AVIF encoding (Fase 8) is slower than
        # WebP on a first, uncached hit for a given image+size.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_connect_timeout 10s;
    }
}


# ===========================================================================
# DO NOT add a trailing-slash redirect at this layer. Fase 1 disabled Next's
# built-in one and re-registered it as the LAST rule, specifically so
# /brands/zoo/ reaches /venues/zoo in a single hop. An nginx-level one puts a
# second hop in front of it, which is the chain the brief prohibits.
#
# AFTER ANY CHANGE HERE
#   sudo nginx -t && sudo systemctl reload nginx          # no [warn] lines
#   for u in http://swillfam.com http://www.swillfam.com https://www.swillfam.com; do
#     curl -sI $u | grep -iE '^(HTTP|location)'; done     # each: ONE 301 to https://swillfam.com/
#   curl -sI http://<server-ip>; echo "exit=$?"           # exit=52, connection closed
#   curl -sI https://swillfam.com | grep -iE '^(HTTP|strict-transport)'
#   sudo certbot renew --dry-run
#
# PRODUCTION ENV (the app, not nginx)
#   SITE_INDEXABLE="true"                                 # else robots.txt is Disallow: /
#   NEXT_PUBLIC_SITE_URL="https://swillfam.com"           # read at BUILD time: rebuild,
#                                                         # then `pm2 reload swillfam`
#   curl -s https://swillfam.com/venues/zoo | grep -o '<link rel="canonical"[^>]*>'
# ===========================================================================
