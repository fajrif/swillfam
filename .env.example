# PostgreSQL connection string (used by both `prisma migrate`/`generate` and the
# running app via the driver adapter in src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/swillfam"

# Admin section (/admin). Generate ADMIN_SESSION_SECRET with: openssl rand -base64 32
# ADMIN_EMAIL/ADMIN_PASSWORD are only used by `npx tsx prisma/seed-admin.ts` to create/update
# the admin account — not read at app runtime.
ADMIN_SESSION_SECRET="[random-base64-secret]"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="[choose-a-strong-password]"
# Initial password for the per-venue operator accounts (admin@<venue>.com) created by
# `npx tsx prisma/seed-admin-users.ts`. Only used when an operator is first created;
# operators should change it from /admin/profile.
OPERATOR_DEFAULT_PASSWORD="[choose-a-strong-password]"

# Set to "true" only once the site is actually served over HTTPS. The admin session
# cookie gets the `Secure` attribute when this is true — browsers silently refuse to
# store `Secure` cookies over plain HTTP, which looks like an instant logout after
# login. Leave "false" (or unset) during IP-only/pre-SSL deployment.
COOKIE_SECURE="false"

# Mapbox public token for the /venues map locator (free tier at https://account.mapbox.com).
# Client-side, so it must be prefixed NEXT_PUBLIC_. Without it the map shows a fallback panel.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.[your-mapbox-public-token]"

# Base URL used to build absolute share links (Promotion/Event share buttons),
# the sitemap, canonical URLs and the @id values in the JSON-LD schema.
NEXT_PUBLIC_SITE_URL="https://swillfam.com"

# Search-engine indexing switch, read by src/app/robots.ts. Indexing is opt-in:
# anything other than "true" serves a blanket `Disallow: /`, so a staging box
# that forgets to set it stays out of the index. PRODUCTION MUST SET THIS TO
# "true" — verify after deploy with: curl -s https://swillfam.com/robots.txt
SITE_INDEXABLE="false"

# Shows the "Structured data" (live JSON-LD preview) section inside every admin
# SEO Details panel. Hidden unless exactly "true". Server-only and read per
# request: change it, then restart (pm2 restart swillfam --update-env); no rebuild.
ADMIN_SHOW_STRUCTURED_DATA="false"
