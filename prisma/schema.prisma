// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum EventType {
  FIXED
  RECURRING
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TalentStatus {
  RESIDENT
  GUEST
}

// --- schema.org vocabulary -------------------------------------------------
//
// The three enums below deliberately break this file's SCREAMING_SNAKE naming:
// their values are schema.org tokens emitted *verbatim* into the JSON-LD
// `@type` / `eventStatus`. Storing them in schema.org's own casing deletes the
// mapping layer that would otherwise sit between the admin and the markup —
// and that mapping layer would be the one place a typo could hide, since a
// wrong `@type` is still syntactically valid JSON-LD and fails silently.
// Adding a type here is a migration; that is the intended friction.

/// Venue `@type`. A venue may carry several (Kilo Jakarta is Restaurant + BarOrPub).
enum VenueSchemaType {
  Restaurant
  BarOrPub
  CafeOrCoffeeShop
  NightClub
}

/// Event `@type`. `Event` is the unspecific base type and the safe default.
enum EventSchemaType {
  MusicEvent
  FoodEvent
  Event
}

/// Event `eventStatus`, emitted as `https://schema.org/<value>`.
enum EventStatus {
  EventScheduled
  EventCancelled
  EventPostponed
  EventRescheduled
}

// ---------------------------------------------------------------------------
// Auth (internal admin accounts) — unchanged from the original project.
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMINISTRATOR // full access, including admin users
  OPERATOR // manages only their own venue's data (+ all talents)
}

model AdminUser {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  fullName          String
  position          String?
  avatar            String?
  role              AdminRole @default(OPERATOR)
  // Operators only: the one venue they manage. Null for administrators.
  venueId           String?
  venue             Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  // Sessions issued before this are rejected (set on any password change/reset).
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Site-wide settings (contact info, social links, etc.).
// ---------------------------------------------------------------------------

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ---------------------------------------------------------------------------
// Meta title/description overrides for the singleton/archive pages that have
// no other backing DB row (Home, About, Contact, the archive indexes, etc).
// Per-record pages (Venue, Event, Talent, Promotion, PrivateEvent, Article,
// Category) instead carry their own metaTitle/metaDescription columns.
// ---------------------------------------------------------------------------

model PageSeo {
  id              String   @id @default(uuid())
  pageKey         String   @unique
  metaTitle       String?
  metaDescription String?
  // Social share image override. Falls back to the record's own banner/poster
  // image, then to the sitewide /og-default.jpg — see src/lib/seo/metadata.ts.
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Public inbox: contact inquiries.
// ---------------------------------------------------------------------------

model Inquiry {
  id          String        @id @default(uuid())
  fullName    String
  email       String
  subject     String
  description String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Careers + public job applications.
// ---------------------------------------------------------------------------

model Career {
  id             String         @id @default(uuid())
  jobTitle       String
  department     String
  employmentType EmploymentType
  location       String
  description    String
  applications   Application[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Application {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  careerId  String?
  career    Career?  @relation(fields: [careerId], references: [id], onDelete: SetNull)
  resumeUrl String // uploaded PDF path under /uploads/applications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Media Mentions (articles online that mention SwillFam).
// ---------------------------------------------------------------------------

model MediaMention {
  id               String   @id @default(uuid())
  title            String
  articleTitle     String
  publicationName  String
  publishedDate    DateTime
  shortDescription String
  link             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Merchandise.
// ---------------------------------------------------------------------------

model Merchandise {
  id               String   @id @default(uuid())
  image            String?
  name             String
  shortDescription String
  price            Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Articles (blog).
// ---------------------------------------------------------------------------

model ArticleCategory {
  id        String    @id @default(uuid())
  name      String
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id                String           @id @default(uuid())
  image             String?
  title             String
  slug              String           @unique
  shortDescription  String
  description       String // rich text (HTML)
  articleCategoryId String?
  articleCategory   ArticleCategory? @relation(fields: [articleCategoryId], references: [id], onDelete: SetNull)
  publishedDate     DateTime
  status            Int              @default(0) // 0 = Draft, 1 = Published
  /// BlogPosting `author`. Plain text — there is no Author model to point at.
  author            String?
  /// "Venues mentioned" — BlogPosting `about`, referencing each venue by @id.
  venues            Venue[] // implicit m2m, same pattern as Event.talents
  metaTitle         String?
  metaDescription   String?
  ogImage           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Venues + their categories, segment galleries, talents.
// ---------------------------------------------------------------------------

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  image            String?
  bannerImage      String?
  caption          String
  headline         String?
  introTitle       String?
  description      String?
  shortDescription String?
  venues           Venue[]
  metaTitle        String?
  metaDescription  String?
  ogImage          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Venue {
  id                       String            @id @default(uuid())
  name                     String
  slug                     String            @unique
  heroTitle                String?
  heroDescription          String?
  talentSectionTitle       String?
  talentSectionDescription String?
  description              String
  shortDescription         String?
  caption                  String?
  image                    String?
  bannerImage              String?
  logo                     String?
  whatsapp                 String?
  phone                    String?
  email                    String?
  placeId                  String?
  categoryId               String?
  category                 Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Free-text display hours ("Monday - Sunday: 12:00 - 03:00"). Kept as the
  // fallback for venues with no `hours` rows yet; once `hours` is populated the
  // public display string is *derived* from it (see src/lib/opening-hours.ts)
  // so the page and the OpeningHoursSpecification markup cannot disagree.
  operatingHours           String
  hours                    VenueHour[]
  location                 String
  // Structured address, split out of the free-text `location` above because
  // PostalAddress needs the parts separately. addressLocality/Region/Country
  // are constants for every SwillFam venue and live in the schema builder.
  streetAddress            String?
  postalCode               String?
  lat                      Float?
  lng                      Float?
  /// schema.org `@type`. Empty until the SEO side fills the fact sheet.
  schemaTypes              VenueSchemaType[]
  /// `servesCuisine` — restaurants and cafés only.
  cuisine                  String?
  /// `sameAs`. One URL for now; schema.org accepts an array if more are added.
  instagramUrl             String?
  spotifyEmbed             String?
  youtubeEmbed             String?
  instagramEmbed           String?
  segmentGalleries         SegmentGallery[]
  talents                  Talent[]
  promotions               Promotion[]
  events                   Event[]           @relation("EventVenue")
  /// Events that list this venue under "Also at" (the primary venue is `events`).
  extraEvents              Event[]           @relation("EventExtraVenues")
  privateEvents            PrivateEvent[] // "Recommended Venues for …" — implicit m2m
  articles                 Article[] // "venues mentioned" in a guide — implicit m2m
  adminUsers               AdminUser[] // operators assigned to this venue
  // Unpublishing hides the venue from the public site and drops it from the
  // sitemap and Organization schema, without deleting its events/promotions.
  published                Boolean           @default(true)
  metaTitle                String?
  metaDescription          String?
  ogImage                  String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
}

/// One opening-hours group for a venue — maps 1:1 to an `OpeningHoursSpecification`.
///
/// A row per *group* rather than per day, because that is the shape schema.org
/// wants: one object listing every day that shares the same open/close pair.
/// Closing after midnight stays on the opening day (`closes: "02:00"`), which
/// is valid and is what the brief specifies.
///
/// `venueId` is optional with `onDelete: SetNull` like every other FK in this
/// file, so deleting a venue can never cascade or fail. Hours are an owned
/// detail though, not an association, so an orphaned row is dead weight rather
/// than a surviving relationship — `deleteVenueAction` clears them explicitly,
/// the same way it unlinks the venue's uploaded files.
model VenueHour {
  id        String    @id @default(uuid())
  venueId   String?
  venue     Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  days      Weekday[]
  opens     String // "HH:mm"
  closes    String // "HH:mm", may be earlier than `opens` when closing after midnight
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SegmentGallery {
  id                String   @id @default(uuid())
  title             String
  description       String
  images            String[] // multiple uploaded image paths, ordered
  // Per-image caption arrays, index-aligned with `images`. Populated only for
  // `special` galleries (the "dishes" template); empty otherwise.
  imageTitles       String[]
  imageDescriptions String[]
  special           Boolean  @default(false)
  venueId           String?
  venue             Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TalentCategory {
  id        String   @id @default(uuid())
  name      String
  talents   Talent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Talent {
  id               String          @id @default(uuid())
  image            String?
  name             String
  slug             String          @unique
  speciality       String
  description      String
  venueId          String?
  venue            Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  talentCategoryId String?
  talentCategory   TalentCategory? @relation(fields: [talentCategoryId], references: [id], onDelete: SetNull)
  status           TalentStatus    @default(RESIDENT)
  instagramUrl     String?
  spotifyEmbed     String?
  youtubeEmbed     String?
  instagramEmbed   String?
  events           Event[] // events this talent is performing at — implicit m2m
  /// false = draft: 404 on the public site, out of the sitemap and every list.
  published        Boolean         @default(true)
  metaTitle        String?
  metaDescription  String?
  ogImage          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Promotions.
// ---------------------------------------------------------------------------

model PromotionCategory {
  id         String      @id @default(uuid())
  name       String
  promotions Promotion[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Promotion {
  id                  String             @id @default(uuid())
  image               String?
  bannerImage         String?
  posterImage         String?
  name                String
  slug                String             @unique
  shortDescription    String
  description         String
  caption             String
  terms               String // rich text (HTML)
  venueId             String?
  venue               Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  promotionCategoryId String?
  promotionCategory   PromotionCategory? @relation(fields: [promotionCategoryId], references: [id], onDelete: SetNull)
  startDate           DateTime
  endDate             DateTime
  startHour           String // "HH:mm"
  endHour             String // "HH:mm"
  /// false = draft: 404 on the public site, out of the sitemap and every list.
  published           Boolean            @default(true)
  metaTitle           String?
  metaDescription     String?
  ogImage             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// Events (fixed-date or recurring).
// ---------------------------------------------------------------------------

model EventCategory {
  id        String   @id @default(uuid())
  name      String
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                     String          @id @default(uuid())
  image                  String?
  bannerImage            String?
  posterImage            String?
  name                   String
  slug                   String          @unique
  shortDescription       String
  description            String
  caption                String
  eventCategoryId        String?
  eventCategory          EventCategory?  @relation(fields: [eventCategoryId], references: [id], onDelete: SetNull)
  venueId                String?
  venue                  Venue?          @relation("EventVenue", fields: [venueId], references: [id], onDelete: SetNull)
  /// Further venues hosting the same event. `venue` stays the primary: its logo is on the card, its address is the schema location.
  extraVenues            Venue[]         @relation("EventExtraVenues")
  talents                Talent[] // talents performing at this event — implicit m2m
  eventType              EventType       @default(FIXED)
  startDate              DateTime
  endDate                DateTime?
  startHour              String // "HH:mm"
  endHour                String // "HH:mm" — the `endDate`/`endTime` pair the brief asks for
  recurringDays          Weekday[] // used when eventType = RECURRING
  /// schema.org `@type` for this event. Defaults to the unspecific base type.
  schemaEventType        EventSchemaType @default(Event)
  /// A postponed or cancelled event keeps its page and dates — only this changes.
  eventStatus            EventStatus     @default(EventScheduled)
  // "Next Edition Event" paragraph on the public page, recurring events only —
  // replaces shortDescription there so the two can read differently.
  nextEditionDescription String?
  featured               Boolean         @default(false)
  // false = retired: hidden from the public calendar + listings, but its detail
  // page still renders (stamped "Past Event", reservations disabled) and it
  // feeds the "Past Editions" grid on recurring event pages.
  active                 Boolean         @default(true)
  /// false = draft: 404 on the public site, out of the sitemap and every list. Stronger than `active`.
  published              Boolean         @default(true)
  galleries              String[] // multiple uploaded image paths, ordered
  ticketInfo             String?
  waPhone                String?
  ticketLink             String?
  // Recap video — a past event's CTA points here instead of at reservations
  // (T12), and it feeds a VideoObject. `recapDuration` is stored as an ISO 8601
  // duration ("PT2M15S"), which is what VideoObject requires; the admin form
  // also accepts "2:15" and normalises on save (src/lib/duration.ts).
  recapVideoUrl          String?
  recapThumbnail         String?
  recapDuration          String?
  metaTitle              String?
  metaDescription        String?
  ogImage                String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Standalone galleries + videos.
// ---------------------------------------------------------------------------

model Gallery {
  id          String   @id @default(uuid())
  image       String?
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Video {
  id          String   @id @default(uuid())
  image       String?
  videoUrl    String // YouTube URL
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// FAQs.
// ---------------------------------------------------------------------------

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String // rich text (HTML)
  // Plural segments ("venues", "private_events") are archive-wide and leave
  // `refSlug` null; singular ones ("venue", "private_event") target the single
  // row whose slug matches `refSlug`. See src/lib/faqs.ts.
  segment   String   @default("general")
  refSlug   String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([segment, refSlug])
}

// ---------------------------------------------------------------------------
// Private events: the "Event Types" tiles + the "Moments We've Hosted" entries.
// (Model is PrivateEventType, not EventType — that name is the FIXED/RECURRING enum.)
// ---------------------------------------------------------------------------

model PrivateEventType {
  id            String         @id @default(uuid())
  image         String?
  title         String
  description   String
  sortOrder     Int            @default(0)
  published     Boolean        @default(true)
  privateEvents PrivateEvent[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PrivateEvent {
  id                 String            @id @default(uuid())
  image              String?
  bannerImage        String?
  title              String
  heroTitle          String?
  slug               String            @unique
  caption            String
  shortDescription   String
  description        String
  privateEventTypeId String?
  privateEventType   PrivateEventType? @relation(fields: [privateEventTypeId], references: [id], onDelete: SetNull)

  // Detail-page section headings. Null falls back to a default in the component,
  // so a new row renders sensibly before anyone fills these in.
  occasionsTitle    String?
  testimonialsTitle String?
  testimonialsLead  String?
  venuesTitle       String?
  galleryTitle      String?
  galleryLead       String?

  galleries    String[] // multiple uploaded image paths, ordered
  venues       Venue[] // "Recommended Venues for …" — implicit m2m
  occasions    PrivateEventOccasion[]
  testimonials PrivateEventTestimonial[]

  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// One "Suitable for Different … Occasions:" card.
model PrivateEventOccasion {
  id             String        @id @default(uuid())
  image          String?
  title          String
  description    String
  sortOrder      Int           @default(0)
  published      Boolean       @default(true)
  privateEventId String?
  privateEvent   PrivateEvent? @relation(fields: [privateEventId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// One "Trusted for Private Moments" quote.
model PrivateEventTestimonial {
  id             String        @id @default(uuid())
  quote          String
  author         String
  sortOrder      Int           @default(0)
  published      Boolean       @default(true)
  privateEventId String?
  privateEvent   PrivateEvent? @relation(fields: [privateEventId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// Alt text for one stored image, keyed by its public path.
///
/// Keyed by the file rather than by a column on each model, which is the one
/// decision worth explaining. Alt text describes *the picture*, so the same
/// file used as a venue's banner and again in a gallery should read the same
/// either way — a `bannerImageAlt` column next to every `bannerImage` would be
/// seventeen columns across eight models that each have to be filled in
/// separately, and `String[]` gallery fields could not use them at all without
/// a parallel array that drifts on every reorder.
///
/// `path` is the primary key because it is already unique: uploads are UUID
/// filenames, and seeded art has one path each. `src/lib/upload.ts` writes
/// these rows alongside the files and deletes them with the file, so an alt can
/// never outlive the image it describes.
///
/// Empty until the content team fills it in; every render site keeps the
/// fallback it has today, so a missing row is never a blank `alt`.
model ImageAlt {
  path      String   @id
  alt       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
